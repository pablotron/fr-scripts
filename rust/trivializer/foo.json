b'[{"name":"Textbook Definitions","description":"FedRAMP Definitions","clues":[{"value":100,"clue":"A specific, packaged cloud computing product or service supplied by a cloud service provider for use by customers, that is the subject of a FedRAMP Certification.","response":"What is a Cloud Service Offering?"},{"value":100,"clue":"The entity responsible for a cloud service offering (CSO) in the context of FedRAMP Certification.","response":"What is a Cloud Service Provider (CSP)?"},{"value":200,"clue":"An entity that helps a provider understand, prepare for, or maintain FedRAMP Certification without replacing the provider\'s responsibility or the assessor\'s independence.","response":"What is an Advisor?"},{"value":200,"clue":"The status of a cloud service offering that has received FedRAMP Certification and meets the legal requirement to be FedRAMP authorized.","response":"What is FedRAMP Certified?"},{"value":300,"clue":"A vulnerability that the provider does not intend to fully mitigate or remediate, OR that has not been fully remediated within the maximum overdue period in FedRAMP Vulnerability Detection and Response rules.","response":"What is an Accepted Vulnerability?"},{"value":300,"clue":"The category of assurance a cloud service offering supplies to federal customers, increasing from minimal assurance at Class A to significant assurance at Class D.","response":"What is a Certification Class?"},{"value":400,"clue":"The combination of a FedRAMP Certification Type (Rev5 or 20x), Path (Program or Agency), and Class (A, B, C, or D) for a cloud service offering.","response":"What is a Certification Profile?"},{"value":400,"clue":"A vulnerability that is not fully mitigated AND is reachable by a likely threat actor.","response":"What is a Likely Exploitable Vulnerability (LEV)?"},{"value":500,"clue":"Verifiable data collected directly from an authoritative source that represents a factual and reproducible observation of a system\'s state, configuration, or behavior.","response":"What is Deterministic Telemetry?"},{"value":500,"clue":"Changes to information resources that cause deviations from the intended and assessed state \xe2\x80\x94 commonly in configurations, deployed software, privileges, running processes, and availability.","response":"What is Drift?"}]},{"name":"KSI Miami","description":"Key Security Indicators","clues":[{"value":100,"clue":"This KSI requires that modifications to the cloud service offering are logged and monitored. (KSI-CMT-LMC)","response":"What is \\\\"Logging Changes\\\\"?"},{"value":100,"clue":"This KSI family abbreviation covers identity and access management.","response":"What is IAM?"},{"value":200,"clue":"This KSI requires that changes to machine-based information resources are executed by redeploying version-controlled resources rather than direct modification wherever reasonable. (KSI-CMT-RMV)","response":"What is \\\\"Redeploying vs Modifying\\\\"?"},{"value":200,"clue":"This KSI calls for the effectiveness of documented change management procedures to be persistently reviewed. (KSI-CMT-RVP)","response":"What is \\\\"Reviewing Change Procedures\\\\"?"},{"value":300,"clue":"This KSI requires the effectiveness of cybersecurity education and training to be persistently reviewed, including general, role-specific, and high-risk-role training. (KSI-CED-RAT)","response":"What is \\\\"Reviewing All Training\\\\"?"},{"value":300,"clue":"This three-letter KSI family abbreviation covers monitoring, logging, and auditing.","response":"What is MLA?"},{"value":400,"clue":"This three-letter KSI family abbreviation covers supply chain risk management.","response":"What is SCR?"},{"value":400,"clue":"This three-letter KSI family abbreviation covers recovery planning as in backups, recovery objectives, and contingency plans.","response":"What is RPL?"},{"value":500,"clue":"Key Security Indicators are written as concise, declarative outcome statements; each KSI also lists these mappings to the older Rev5 baseline.","response":"What are Related SP 800-53 Controls?"},{"value":500,"clue":"This three-letter KSI family abbreviation concerns inventories and the policy/inventory domain.","response":"What is PIY (Policy and Inventory)?"}]},{"name":"The Sacred Texts","description":"Rulesets & Reference","clues":[{"value":100,"clue":"This ruleset require providers to continuously identify, analyze, prioritize, and respond to weaknesses in their offering.","response":"What is Vulnerability Detection and Response?"},{"value":200,"clue":"These rules help agencies use shared, current authorization information to monitor a cloud offering together rather than in isolation.","response":"What is Collaborative Continuous Monitoring?"},{"value":200,"clue":"This ruleset outline the expectations for a simple, plain-language overview of a provider\'s certification.","response":"What is the Certification Package Overview?"},{"value":300,"clue":"This ruleset govern how FedRAMP and providers exchange messages and how urgency is conveyed.","response":"What is Addressing FedRAMP Communication?"},{"value":300,"clue":"This ruleset clarify how providers should select and use cryptographic modules in a FedRAMP context.","response":"What is Cryptographic Module Use?"},{"value":400,"clue":"This ruleset summarize the demands the FedRAMP Authorization Act and OMB M-24-15 place on agencies into a simple, FedRAMP-style rule set.","response":"What is Agency Use of FedRAMP Certified Cloud Services?"},{"value":400,"clue":"This ruleset let providers store and share their FedRAMP Certification data with agencies and FedRAMP.","response":"What is Certification Data Sharing?"},{"value":500,"clue":"This ruleset govern how an offering reports and communicates an incident, supporting initial, ongoing, and final report variants.","response":"What is Incident Evaluation and Communication?"},{"value":500,"clue":"This ruleset define the conditions and process for notifying FedRAMP when an offering undergoes a material change.","response":"What is Significant Change Notification?"}]},{"name":"Welcome to Whoville","description":"Stakeholders & Roles","clues":[{"value":100,"clue":"Federal agencies must ensure any cloud service they use within FedRAMP\'s scope has a FedRAMP Certification; these stakeholders are the government customers.","response":"What are Agencies?"},{"value":200,"clue":"This stakeholder performs assessment, verification, or validation activities for an offering seeking to obtain or maintain FedRAMP Certification.","response":"What is an Assessor?"},{"value":200,"clue":"This stakeholder helps a provider navigate the federal marketplace and prepare for FedRAMP without replacing the provider\'s responsibility or the assessor\'s independence.","response":"What is an Advisor?"},{"value":300,"clue":"Independent assessment services that hold this status are authorized by FedRAMP to perform assessment activities on its behalf.","response":"What is FedRAMP Recognized?"},{"value":400,"clue":"These federal entities have interests directly affected (or likely to be) by a vulnerability or incident involving federal customer data; this always includes FedRAMP and impacted agency customers.","response":"What are All Affected Parties?"},{"value":400,"clue":"This stakeholder is the cloud service provider responsible for a cloud service offering in the context of FedRAMP Certification.","response":"What is a Provider?"},{"value":500,"clue":"This entity, established in law at the end of 2022 with government-wide guidance in 2024, operates the program and issues certifications.","response":"What is FedRAMP (the program)?"},{"value":500,"clue":"All entities who participate in the FedRAMP assessment of a cloud service offering in the context of a FedRAMP Certification are referred to collectively by this defined term.","response":"What are All Necessary Assessors?"}]},{"name":"I am the law","description":"Scope & Authority","clues":[{"value":100,"clue":"FedRAMP was established in law to provide a standardized approach to the assessment and authorization of these products and services that process unclassified federal information.","response":"What is cloud computing (cloud services)?"},{"value":200,"clue":"This OMB Memorandum is quoted directly to define FedRAMP\'s scope as cloud products and services (IaaS, PaaS, SaaS) that handle federal information.","response":"What is OMB Memorandum M-24-15?"},{"value":300,"clue":"FedRAMP does not apply to every internet-based service an agency uses; a single cloud service may even be partly within and partly outside scope, judged by these.","response":"What are Agency Use Case Indicators?"},{"value":300,"clue":"Certain categories of cloud products and services are specified as this relative to FedRAMP, subject to exceptions made by the FedRAMP Director.","response":"What is Outside the Scope of FedRAMP?"},{"value":400,"clue":"This 2022 law formally established the modern FedRAMP program and mandated a government-wide overhaul.","response":"What is the FedRAMP Authorization Act?"},{"value":500,"clue":"The FedRAMP Definitions cite this title of the U.S. Code repeatedly for terms like \\\\"agency,\\\\" \\\\"machine-readable,\\\\" and \\\\"information resource.\\\\"","response":"What is 44 U.S. Code?"}]},{"name":"Future info@","description":"Changes to info@fedramp.gov","clues":[{"value":100,"clue":"This is the only Rev5 Class D path.","response":"What is Agency Sponsorship?"},{"value":200,"clue":"An advisory service or independent assessor cannot do this on behalf of their client.","response":"What is apply for a FedRAMP Certification? (See FRC-APP-NTP)"},{"value":300,"clue":"True or false: I am not planning on selling to an agency, can I still get a FedRAMP Certification?","response":"What is True? If you fall under the indirect use category where you will be a third-party information resource for other cloud providers."},{"value":400,"clue":"A Trust Center doesn\'t need to be FedRAMP Certified if it is not storing this information.","response":"What is federal information? Trust Center info is the CSP\'s data, not the government\'s."},{"value":500,"clue":"This is issued if an existing service does not adopt the VDR / VER by the mandatory date.","response":"What is a corrective action plan (CAP)? Cloud service providers are allowed a grace period until March 7, 2027. After that, they will be removed from the Marketplace."}]},{"name":"Important Dates","description":"Key FedRAMP timelines and deadlines","clues":[{"value":100,"clue":"This date is when a provider can submit for Class A.","response":"What is August 3rd, 2026?"},{"value":200,"clue":"This time period is when a provider can submit for a 20x Class D.","response":"What is 20x Phase 4? Currently scheduled for FY27 Q1 - FY27 Q2."},{"value":300,"clue":"This date is when FedRAMP no longer accept applications for new Rev5 Certifications.","response":"What is June 11, 2027?"},{"value":400,"clue":"This date is when CR26 rules are required to be implemented by existing cloud service providers.","response":"What is January 1st, 2027?"},{"value":500,"clue":"CR26 rules apply until this date.","response":"What is December 31, 2028?"}]},{"name":"Other Frameworks, True/False","description":"Conversions, equivalencies, and alternative security frameworks","clues":[{"value":100,"clue":"I can convert my FedRAMP Ready / RAR to Rev5 Class B or C, or 20x Class A.","response":"What is True? However, conversion is not automatic and requires meeting specific requirements for those certifications."},{"value":200,"clue":"I can use a FedRAMP Moderate Equivalency Audit for a Class C.","response":"What is False? Only a SOC 2 Type II, GovRAMP, or FedRAMP Rev5 are approved alternative security frameworks."},{"value":300,"clue":"I can use an ISO 27001 for FedRAMP.","response":"What is False? Only a SOC 2 Type II, GovRAMP, or FedRAMP Rev5 are approved alternative security frameworks for Class A."},{"value":400,"clue":"A Class A certification package is required to be independently verified and validated by an accessor before submission.","response":"What is False? They may be validated but it is not required."},{"value":500,"clue":"FedRAMP Certification has equivalency to CMMC for DOW.","response":"What is False? The concept of \\\\"equivalency\\\\" is defined under DFARS 252.204-7012. CMMC and FedRAMP requirements are not bidirectional. FedRAMP does not substitute for CMMC. CMMC does not subsitute for FedRAMP Certifications of a specific cloud service offering."}]},{"name":"The Package","description":"Package materials, templates, and certification data","clues":[{"value":100,"clue":"Providers must have this prerequisite before submitting package materials.","response":"What is a FedRAMP Marketplace listing?"},{"value":200,"clue":"This template is used to document POA&Ms for VDR.","response":"What is None? There is no POA&M with VDR."},{"value":300,"clue":"This replaces the System Security Plan & Appendices for all certification types.","response":"What are the Certification Package Overview and Security Decision Record (SDR)?"},{"value":400,"clue":"This effectively replaces the SAP and SAR in all certification types.","response":"What are the Certification Package Overview and Security Decision Record (SDR)?"},{"value":500,"clue":"This data is not certification data.","response":"What is federal customer data? Certification data is produced by the CSP for its own purposes (including legacy vulnerability scans, POA&Ms, etc.), and is all owned by the CSP."}]},{"name":"The Agency","description":"Agency sponsorship, use, and oversight","clues":[{"value":100,"clue":"Who sponsors a Class A certification?","response":"What is Program? Class A is 20x only, but can be used for a higher Rev5 or 20x certification."},{"value":200,"clue":"This is how you access a 20x package.","response":"What is talk to the CSP for access instructions and approval?"},{"value":300,"clue":"For a limited time, FedRAMP will do this if a CSP lost their agency sponsor.","response":"What is grant Class B or C certification? Only if the CSP was listed on the Marketplace but was removed or completed a full assessment with SAP/SAR between January 2025 and March 2026."},{"value":400,"clue":"A Class A Certification is sufficient for use in this deployment environment at an agency.","response":"What is Production? It\'s up to the agency to accept the risk!"},{"value":500,"clue":"These organizations monitor agencies and their compliance with the law and policy.","response":"What are the Office of Management and Budget (OMB), Inspector Generals, and the Government Accountability Office (GAO)? Not FedRAMP!"}]}]'
